{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  // useImportType is disabled repo-wide: NestJS DI resolves constructor params
  // and ValidationPipe DTO metatypes via emitDecoratorMetadata's design:paramtypes,
  // which need runtime value imports — the rule flags every such import as a
  // false positive (was 74 ignored instances). TS import elision (verbatimModuleSyntax
  // is NOT enabled) already strips pure-type imports from the emit, so nothing is lost.
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "useImportType": "off" }
    }
  },
  "files": {
    // Playwright writes failure artifacts into these directories, and Biome
    // does not read .gitignore, so they must be excluded explicitly or a failing
    // `test:viewport` run breaks the next `pnpm verify`.
    "includes": [
      "**",
      "!**/*.css",
      "!**/dist",
      "!**/test-results",
      "!**/playwright-report"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.spec.ts", "**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "auto"
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always" },
    "parser": { "unsafeParameterDecoratorsEnabled": true }
  }
}
