# Database (all required for the app to boot)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=casso
DB_PASSWORD=change-me
DB_DATABASE=casso_ledger
CORS_ORIGIN=http://localhost:5173
APP_WEB_URL=https://app.casso.vn
LOG_LEVEL=info
SLOW_REQUEST_THRESHOLD_MS=2000

# AES-256-GCM key for encrypted credentials (API Keys, secure tokens): exactly 64 hexadecimal characters.
ACCESS_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# The webhook URL this product registers with Casso Flow via POST /v2/webhooks
# on every connect (Task 5). A platform-level constant — the API Key itself is
# per-organization and supplied through the UI, not read from process.env.
CASSO_FLOW_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/casso-balance-hook

SMTP_HOST_ALLOWLIST=
RESEND_API_KEY=re_placeholder
RESEND_FROM_ADDRESS=noreply@ngocanh2005it.site
REDIS_HOST=localhost
REDIS_PORT=6379
AI_PROVIDER_API_KEY=replace-with-provider-key
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_MODEL=openai/gpt-4o-mini

PAYOS_CLIENT_ID=dev-payos-client-id
PAYOS_API_KEY=dev-payos-api-key
PAYOS_CHECKSUM_KEY=change-me
PAYOS_RETURN_URL_ALLOWLIST=http://localhost:5173

# Swagger docs (required only when NODE_ENV=production — dev/test serve docs open)
SWAGGER_USER=admin
SWAGGER_PASSWORD=change-me

VIETQR_API_BASE_URL=https://api.vietqr.io/v2/business
