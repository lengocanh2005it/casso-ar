{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["biome.jsonc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"]
    },
    "test:viewport": {
      "dependsOn": ["^build"],
      "env": ["PLAYWRIGHT_CHANNEL"]
    },
    "arch-check": {}
  }
}
